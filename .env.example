DATABASE_URL=postgresql+psycopg2://care:carepass@postgres:5432/careplatform
POSTGRES_USER=care
POSTGRES_PASSWORD=carepass
POSTGRES_DB=careplatform
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# --- LLM wording (OpenAI-compatible): Grok (xAI) or GPT-OSS via Groq.
# Grok:        GROK_MODEL=grok-3-mini (or grok-4), GROK_BASE_URL=https://api.x.ai/v1, key from https://console.x.ai
# GPT-OSS-120B: GROK_MODEL=openai/gpt-oss-120b, GROK_BASE_URL=https://api.groq.com/openai/v1, key (gsk_...) from https://console.groq.com
# Paste the key into .env (never commit it), then restart: docker compose up -d backend
GROK_API_KEY=
GROK_MODEL=openai/gpt-oss-120b
GROK_BASE_URL=https://api.groq.com/openai/v1
VOICE_STT_PROVIDER=browser
VOICE_TTS_PROVIDER=browser
VOICE_API_KEY=
MOCK_EHR_URL=http://mock-ehr:8001
MOCK_EHR_API_KEY=mock-ehr-dev-key
BACKEND_CORS_ORIGINS=http://localhost:8080,http://localhost:3000
ENVIRONMENT=development
SEED_ON_STARTUP=true
FAILURE_INJECTION_RATE=0.0
