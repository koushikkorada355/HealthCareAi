DATABASE_URL=postgresql+psycopg2://care:carepass@postgres:5432/careplatform
POSTGRES_USER=care
POSTGRES_PASSWORD=carepass
POSTGRES_DB=careplatform
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# --- Grok (xAI) — paste your key here to enable Grok wording in chat + voice.
# Get one at https://console.x.ai — then restart: docker compose up -d backend
GROK_API_KEY=
GROK_MODEL=grok-3-mini
GROK_BASE_URL=https://api.x.ai/v1
VOICE_STT_PROVIDER=browser
VOICE_TTS_PROVIDER=browser
VOICE_API_KEY=
MOCK_EHR_URL=http://mock-ehr:8001
MOCK_EHR_API_KEY=mock-ehr-dev-key
BACKEND_CORS_ORIGINS=http://localhost:8080,http://localhost:3000
ENVIRONMENT=development
SEED_ON_STARTUP=true
FAILURE_INJECTION_RATE=0.0
